# Copy to `.env` for local Expo, or set the same names as EAS secrets.
# Never commit real keys. The app runs fully offline without any of these.
# Restart Metro after changing values so EXPO_PUBLIC_* reload.
# Full walkthrough: docs/LOCAL_SETUP.md

# --- Supabase (optional — premium Auth + cloud sync) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Weather enrichment (optional — keyed providers) ---
# Keyless Open-Meteo, MET Norway, and NWS (US) work with no keys.
# Set these only if you want OpenWeather / WeatherAPI in the multi-source merge.
EXPO_PUBLIC_OPENWEATHER_API_KEY=
EXPO_PUBLIC_WEATHERAPI_KEY=
