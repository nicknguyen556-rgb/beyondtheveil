{
  "expo": {
    "name": "Geocatch Datalink",
    "slug": "geocatch-datalink",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "geocatch",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beyondtheveil.geocatch",
      "infoPlist": {
        "NSCameraUsageDescription": "Geocatch needs the camera to capture field photos.",
        "NSPhotoLibraryUsageDescription": "Geocatch needs your library to import field photos.",
        "NSLocationWhenInUseUsageDescription": "Geocatch uses your location when a photo has no EXIF GPS, and for map pins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2A1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.beyondtheveil.geocatch",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Geocatch to import field photos.",
          "cameraPermission": "Allow Geocatch to capture field photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Geocatch to use your location when EXIF GPS is missing or for map pins."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
